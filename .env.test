BACKEND_URL=http://localhost:3101
SESSION_SECRET=e2e-session-secret-only-for-tests-0123456789abcdef
NEXT_PUBLIC_BACKEND_CMS_URL=http://cms-backend.e2e.local
NEXT_PUBLIC_PROYECTO_ID=e2e-test-project

# Muestra en /pago/[orderId] los botones de pago simulado, que los e2e de consulta y carro siguen usando.
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATION=true
# Habilita "Pagar con Webpay" (en producción queda apagado hasta que Transbank valide la integración).
NEXT_PUBLIC_WEBPAY_ENABLED=true
# El formulario de pago de los e2e es el Webpay falso del backend falso (CSP form-action, ver src/proxy.ts).
WEBPAY_FORM_ORIGINS=http://localhost:3101
