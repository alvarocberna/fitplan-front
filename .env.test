# Configuración completa de los e2e (valores ficticios, sin secretos). Define todas las variables que usa la
# app para que Next no tome ninguna del .env local: las variables ya presentes en el proceso tienen prioridad.
BACKEND_URL=http://localhost:3101
SESSION_SECRET=e2e-session-secret-only-for-tests-0123456789abcdef
# El CMS también lo reemplaza el backend falso.
NEXT_PUBLIC_BACKEND_CMS_URL=http://localhost:3101/__cms
NEXT_PUBLIC_PROYECTO_ID=e2e-test-project

# Cognito no se usa: los tests fabrican la cookie de sesión. Hosts .invalid para que nada llegue a un servicio real.
COGNITO_ISSUER_URL=https://cognito.e2e.invalid
COGNITO_CLIENT_ID=e2e-client-id
COGNITO_CLIENT_SECRET=e2e-client-secret
COGNITO_REDIRECT_URI=http://localhost:3100/api/cognito/callback
COGNITO_DOMAIN=https://cognito.e2e.invalid

# Muestra en /pago/[orderId] los botones de pago simulado, que los e2e de consulta y carro siguen usando.
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATION=true
# Habilita "Pagar con Webpay" (en producción queda apagado hasta que Transbank valide la integración).
NEXT_PUBLIC_WEBPAY_ENABLED=true
# El formulario de pago de los e2e es el Webpay falso del backend falso (CSP form-action, ver src/proxy.ts).
WEBPAY_FORM_ORIGINS=http://localhost:3101
